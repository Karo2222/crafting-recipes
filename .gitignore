# Firebase client config (keep local)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# CocoaPods lock files are regenerated on build
ios/Podfile.lock
macos/Podfile.lock

